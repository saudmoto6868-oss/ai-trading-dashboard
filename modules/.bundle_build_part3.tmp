    cb.onclick = () => { if (live){ if (GLive.on && GLive.stream) GLive.stop(); else { if (GLive.on) GLive.stop(true); GVoice.stop(); this.man.classList.add("live"); GLive.start().then(() => this.bot()); } this.bot(); return; }
