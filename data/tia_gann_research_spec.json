  "open_questions": [
    "identify exact wheel convention in each archived Gann image",
    "separate original Gann source from modern reinterpretation",
    "verify whether 24-part wheel and spiral formula are equivalent",
    "recover historical chart price/time scale",
    "test predictive value after costs against simple baselines",
    "reconstruct historical examples point-in-time including failures",
    "test calibration stability across market regimes"
  ]
}
