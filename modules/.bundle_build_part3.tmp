    + '<linearGradient id="gSuit" x1="0" x2="1"><stop offset="0" stop-color="'+C.suit2+'"/><stop offset=".45" stop-color="'+C.suit+'"/><stop offset="1" stop-color="'+C.suit2+'"/></linearGradient>'
