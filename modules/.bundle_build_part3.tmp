    const L = [["video/mp4;codecs=avc1.640034", "mp4", .40], ["video/mp4;codecs=avc1.640033", "mp4", .40], ["video/mp4;codecs=avc1", "mp4", .40], ["video/webm;codecs=vp9", "webm", .25], ["video/webm;codecs=vp8", "webm", .2], ["video/webm", "webm", .2]];
