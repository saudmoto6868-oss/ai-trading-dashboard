  pad: t => String(Math.max(0, Math.floor(t))).padStart(13, "0"),
  join(cov, a, b){ if (!(b > a)) return cov.slice(); let na = a, nb = b; const out = [];   // add (a, b] to a sorted list of ranges; ranges that touch merge
