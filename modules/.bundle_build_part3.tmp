  const armR = armL.replace(/M(\d+) (\d+) Q(\d+) (\d+) (\d+) (\d+) L(\d+) (\d+) Q(\d+) (\d+) (\d+) (\d+) Z/g, (s, a,b,c,d,e,f,g,h,i,j,k,l) => "M"+m(+a)+" "+b+" Q"+m(+c)+" "+d+" "+m(+e)+" "+f+" L"+m(+g)+" "+h+" Q"+m(+i)+" "+j+" "+m(+k)+" "+l+" Z")
    .replace('x="45.5"', 'x="139.5"').replace('cx="53"', 'cx="147"');
