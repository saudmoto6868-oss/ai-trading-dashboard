 ar:{add:"+ ويدجت",trading:"تخطيط التداول",blank:"مساحة فاضية",smart:"سمارت ×",big:"كبير ×",abs:"امتصاص ×",
  vwap:"VWAP",kzTip:"كيل زون (توقيت نيويورك): آسيا 20-24، لندن 02-05، نيويورك صباحا 07-10، نيويورك مساء 13:30-16 مع أعلى/أقل سعر لكل جلسة (فريم ساعة وأقل)",setupmode:"شكل الصفقة",mLines:"الصفقة: خطوط",mBox:"الصفقة: مربع",tCur:"تحديد / تحريك",tTrend:"خط اتجاه",tH:"خط أفقي",tFib:"فيبوناتشي (اختار النسب)",indBvd:"دلتا حجم الاختراق (Breakout Volume Delta)",indEw:"موجات إليوت (تلقائي 1-2-3-4-5 / A-B-C)",bvdTip:"إغلاق خارج سوينج هاي/لو مع علامة شراء/بيع % (مين الأقوى جوه شمعة الاختراق) أو ⚠ ضعيف. بيستخدم دلتا الصفقات الحية لو موجودة وإلا موقع الإغلاق جوه الشمعة (~).",auto:"تلقائي",manual:"يدوي",lockTip:"تلقائي: مقياس السعر بيتبع الشموع. يدوي: المقياس بيثبت زي ما ظبطته (اسحب أو لف العجلة على محور السعر).",indVol:"الفوليوم (بلون الدلتا)",openDot:"افتح عمق السوق",closeDot:"اقفل عمق السوق",ofSet:"إعدادات عمق التداول (الألوان والأحجام)",indDot:"أوردر فلو: نقط سويب ◆ / امتصاص ⊗",dotTip:"السويب = معين، الامتصاص = دايرة بعلامة X (وخط متقطع للهدف). بنفس ألوان الفقاعات وخريطة السيولة والتايم آند سيلز.",indDot3:"عمق التداول (فقاعات + DOM + نقط + BUY/SELL)",dot3Tip:"يشغّل أو يطفّي عرض الأوردر فلو كله مرة واحدة",indBub:"أوردر فلو: فقاعات (الصفقات الكبيرة)",bubTip:"دايرة لكل صفقة كبيرة، الحجم = الكمية، أخضر شراء / أحمر بيع (⚙ للألوان والحجم). بتتبني من الصفقات الحية.",indDom:"أوردر فلو: خريطة السيولة (DOM)",domTip:"السيولة الواقفة في دفتر الأوامر خلف الشموع، الحرارة = الحجم. بتتبني من الدفتر الحي طول ما الشارت مفتوح.",indMk:"أوردر فلو: علامات BUY/SELL والأهداف",indFp:"شموع فوت برينت (بيع × شراء لكل سعر)",fpTip:"لكل سعر جوه الشمعة: بيع × شراء، وPOC بإطار أصفر، والاختلال 3:1 بخط عريض. بيتبني من الصفقات الحية طول ما الشارت مفتوح، قرّب عشان تشوف الأرقام.",indDelta:"أوردر فلو: دلتا كل شمعة",deltaTip:"حجم الشراء ناقص حجم البيع لكل شمعة (بيتبني من الصفقات الحية)",tRect:"مستطيل",tChan:"قناة متوازية (3 نقرات)",tText:"ملاحظة نصية",valuelv:"مستويات القيمة",web:"شارت خارجي (ChartLabs)",liq:"التصفيات (OKX)",rsihm:"خريطة RSI",posn:"التمركز: OI + لونج/شورت",tclass:"Trade Classes",tvc:"شارت TradingView (لحظي)",fundhm:"خريطة التمويل",fund:"التحليل الأساسي (كريبتو)",cmc:"CoinMarketCap",macrof:"الماكرو وCOT",stockf:"أساسيات الأسهم",risk:"إدارة المخاطر",indVp:"بروفايل الحجم (POC/VA)",vpTip:"بروفايل الحجم للشموع المحملة: POC أكثر سعر اتداول عليه، VAH/VAL منطقة القيمة 70%",indHarm:"الأنماط التوافقية (Harmonic)",harmTip:"رسم XABCD تلقائي: Gartley / Bat / Butterfly / Crab / Cypher",fibPreset:"مستويات الفيبوناتشي",tWave:"موجات إليوت (6 نقرات: 0-5)",tLong:"صفقة شراء (R:R)",tShort:"صفقة بيع (R:R)",tDel:"حذف المحدد",tClr:"مسح كل الرسومات (اضغط مرتين)",sig:"الإشارات",flow:"التدفق",rf:"التحديث",fAll:"الكل",fBid:"شراء",fAsk:"بيع",fAbs:"امتصاص",win:"النافذة",event:"الحدث",side:"الجهة",note:"ملاحظة",links:"الروابط",ticker:"شريط الأخبار",showchart:"اعرضها على الشارت",tvopen:"TradingView",strats:"استراتيجيات",eta:"الوقت المتوقع",entry:"دخول",stop:"وقف",alerts:"التنبيهات",addsym:"أضف رمز مثل PEPE-USDT",clear:"مسح",noalerts:"مفيش صفقات مطابقة — صفقات السكانر (موجة 3، كروس EMA على فريم عالي...) هتظهر هنا.",conf:"نسبة الثقة",chart:"الشارت",dom:"عمق السوق",tape:"الصفقات",ofm:"خريطة الأوردر فلو",limits:"تتبع الأوامر",watch:"قائمة المراقبة",news:"الأخبار",video:"فيديو",notes:"ملاحظات",academy:"ذكاء الأكاديمية",setup:"سيت اب",signals:"الإشارات",settings:"الإعدادات",stTheme:"الثيم",stCandles:"ألوان الشموع",stUp:"صاعد",stDn:"هابط",stBg:"الخلفية",stReset:"رجّع لألوان الثيم",stNote:"بتتحفظ في المتصفح ده. بتطبق على كل الشارتات واللوحات.",sgSearch:"ابحث برمز / استراتيجية",sgAge:"العمر",sgSrc:"المصدر",sgAny:"الكل",sgMin:"أقل قوة",sgNone:"مفيش إشارات بالفلاتر دي",sgCount:"إشارة",sgScan:"سكان",sgAlert:"تنبيه",sgTiming:"التوقيت",tmNow:"عند الدخول",tmWait:"مستني",tmRun:"ماشية",tmLate:"متأخرة - ما تلاحقش",tmStop:"ضربت الستوب",tmTp:"ضربت TP1",tmNA:"مفيش سعر",sgTimeTip:"طبقة التوقيت: السعر دلوقتي فين من الخطة. عند الدخول = في حدود 0.25 R من الدخول؛ مستني = لسه ما وصلش؛ ماشية = في ربح وأقل من نص الطريق لـ TP1؛ متأخرة = عدّت نص الطريق (مطاردة)؛ ضربت الستوب/TP1 = اتحسمت.",sgPipTip:"خطة فوركس بستوب 30-50 ن